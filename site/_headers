# Cabeçalhos servidos pelo Workers Static Assets. Só valem para respostas de assets.

# Segurança (Fase 4), em toda resposta. Sem 'unsafe-inline': não há script nem style inline no site.
# - 'wasm-unsafe-eval': o OCR (Tesseract) compila WebAssembly a partir de bytes; sem isso o OCR não roda.
#   Não libera eval() de JavaScript.
# - connect-src inclui só o Nominatim (OpenStreetMap), acionado por clique explícito em "Localizar CEP".
# - worker-src 'self': workers do pdf.js e do Tesseract são arquivos da própria origem (sem blob:).
# - manifest-src 'self': site.webmanifest (Fase 6).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://nominatim.openstreetmap.org; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=15552000

# Tudo em /assets/ tem fingerprint no nome ou diretório versionado: cache imutável de 1 ano.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML e demais arquivos sem regra própria já recebem o default do Workers Assets:
# Cache-Control: public, max-age=0, must-revalidate.
/version.json
  Cache-Control: no-store

# Imagens e manifesto na raiz não têm fingerprint (a URL do og:image precisa ser estável): um dia de cache.
/*.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400

# URLs *.workers.dev (avm-sp.heybrain.workers.dev e os aliases de preview <id>-avm-sp.heybrain.workers.dev)
# não competem com avm.heybrain.uk nos buscadores. Padrão com placeholders, conforme a documentação.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
