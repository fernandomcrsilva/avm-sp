{
  // Cloudflare Workers Static Assets + um Worker script mínimo (src/worker.js) que só atende POST /api/erro.
  // Os cabeçalhos de _headers valem para os assets; as respostas do script trazem os seus próprios (no código).
  "name": "avm-sp",
  "main": "src/worker.js", // só POST /api/erro (avisos técnicos anônimos → Workers Logs); o resto é asset
  "compatibility_date": "2026-09-07",
  "account_id": "ee92a19319ea452a3e1b995058bb5a33",
  // Sem build.command: o dist/ vem de `npm run build`, rodado antes (CI: passo sem token; local: npm run check).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // Limite por IP do /api/erro (VULN-005): 5 avisos por minuto. O rate limit da zona não cobre *.workers.dev.
  "ratelimits": [{ "name": "ERRO_RL", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  // Workers Logs (retenção de 3 dias no plano Free) com logs de invocação: quem chamou /api/erro e o que o front reportou.
  "observability": { "enabled": true, "logs": { "invocation_logs": true, "head_sampling_rate": 1 } },
  // Produção: Custom Domain (cria o DNS e emite o certificado no deploy). Subdomínio, sem www.
  "routes": [{ "pattern": "avm.heybrain.uk", "custom_domain": true }],
  // avm-sp.heybrain.workers.dev e os aliases de preview ficam ligados (default); noindex via _headers.
}
